---
import PostSidebar from "./PostSidebar.astro";
import type { TocItem } from "../../lib/toc";

interface Props {
  date: Date;
  day: number;
  topic?: string;
  tags?: string[];
  readMinutes?: number;
  toc?: TocItem[];
}

const { date, day, topic, tags = [], readMinutes, toc } = Astro.props;
---

<div class="post-shell">
  <div class="sidebar-col">
    <PostSidebar date={date} day={day} topic={topic} tags={tags} readMinutes={readMinutes} toc={toc} />
  </div>
  <div class="main-col">
    <slot />
  </div>
</div>

<style>
  .post-shell {
    display: grid;
    grid-template-columns: 11.5rem minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
  }
  .sidebar-col {
    position: sticky;
    top: 4rem;
    max-height: calc(100vh - 5rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  @media (max-width: 860px) {
    .post-shell {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .sidebar-col {
      position: static;
      max-height: none;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--c-border);
    }
    .sidebar-col :global(.toc) {
      display: none;
    }
  }
</style>
