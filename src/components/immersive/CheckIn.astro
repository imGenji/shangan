---
interface Props {
  day: number;
}

const { day } = Astro.props;
---

<footer class="checkin">
  <button id="checkin" type="button" data-day={day} aria-pressed="false">
    <span class="mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
        stroke-linecap="round" stroke-linejoin="round">
        <path class="tick" d="M4 12.5 L9.5 18 L20 6.5" />
      </svg>
    </span>
    <span class="label">标记本篇已完成</span>
  </button>
  <p class="streak meta" hidden></p>
</footer>

<script>
  import {
    bumpDay,
    readCheckins,
    removeCheckin,
    todayKey,
    writeCheckins,
  } from "../../lib/activity";
  import { PLANNED_ARTICLES } from "../../data/plan";

  const btn = document.getElementById("checkin") as HTMLButtonElement | null;

  if (btn) {
    const day = Number(btn.dataset.day);
    const label = btn.querySelector<HTMLElement>(".label")!;
    const streak = document.querySelector<HTMLElement>(".streak")!;

    const paint = (done: boolean, animate: boolean) => {
      btn.dataset.done = String(done);
      btn.setAttribute("aria-pressed", String(done));
      label.textContent = done ? "已完成 · 点击撤销" : "标记本篇已完成";
      btn.classList.toggle("pop", animate && done);

      const learningDone = readCheckins().filter((e) => e.day > 0).length;
      streak.hidden = learningDone === 0;
      streak.textContent = `已完成 ${learningDone} / ${PLANNED_ARTICLES} 篇`;
    };

    /** 纸质配色的礼花，避免默认彩虹色跟站点调性冲突 */
    const celebrate = async () => {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const { default: confetti } = await import("canvas-confetti");
      const r = btn.getBoundingClientRect();
      confetti({
        particleCount: 70,
        spread: 62,
        startVelocity: 32,
        scalar: 0.85,
        ticks: 140,
        origin: {
          x: (r.left + r.width / 2) / window.innerWidth,
          y: (r.top + r.height / 2) / window.innerHeight,
        },
        colors: ["#b35a1f", "#1f5c8c", "#4a6b3e", "#a87a1f", "#d1855a"],
      });
    };

    btn.addEventListener("click", () => {
      const entries = readCheckins();
      const hit = entries.find((e) => e.day === day);
      if (hit) {
        writeCheckins(entries.filter((e) => e.day !== day));
        removeCheckin(day, hit.at);
        paint(false, false);
      } else {
        const at = todayKey();
        writeCheckins([...entries, { day, at }]);
        bumpDay(at, { addCheckin: day });
        paint(true, true);
        celebrate();
      }
      window.dispatchEvent(new Event("activity-change"));
    });

    paint(readCheckins().some((e) => e.day === day), false);
  }
</script>

<style>
  .checkin {
    margin-top: 4.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--c-border);
    display: flex;
    align-items: center;
    gap: 1.1rem;
    flex-wrap: wrap;
  }
  #checkin {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--paper);
    border: 1px solid var(--c-border-light);
    border-radius: 3px;
    color: var(--c-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.95rem;
    padding: 0.55rem 1.15rem;
    transition: border-color 0.18s, color 0.18s, background-color 0.18s;
  }
  #checkin:hover {
    border-color: var(--good);
  }
  #checkin[data-done="true"] {
    border-color: var(--good);
    background: var(--good-pale);
    color: var(--good);
  }
  .mark {
    display: inline-flex;
    width: 1.05rem;
    height: 1.05rem;
  }
  .mark svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .tick {
    stroke-dasharray: 30;
    stroke-dashoffset: 30;
    opacity: 0.25;
  }
  #checkin[data-done="true"] .tick {
    stroke-dashoffset: 0;
    opacity: 1;
    transition: stroke-dashoffset 0.4s cubic-bezier(0.65, 0, 0.35, 1) 0.05s, opacity 0.15s;
  }
  /* 勾描完的同时按钮轻微回弹，动作要短，别喧宾夺主 */
  #checkin.pop {
    animation: pop 0.34s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes pop {
    40% {
      transform: scale(1.045);
    }
    100% {
      transform: scale(1);
    }
  }
  .streak {
    color: var(--c-text-dim);
  }
</style>
