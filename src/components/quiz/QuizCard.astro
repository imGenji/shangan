---
import type { QuizKind, QuizOption } from "../../lib/quizzes";
import { KIND_LABEL, FRESHNESS_NOTE } from "../../lib/quizzes";

interface Props {
  id: string;
  seq?: number;
  stem: string;
  options: QuizOption[];
  answer: string[];
  kind: QuizKind;
  year?: number | null;
  point?: string;
  /** 题库自带解析 */
  analysis?: string;
  /** AI 生成的深度解析，提交后与题库解析一并展示 */
  aiAnalysis?: string;
  freshness?: keyof typeof FRESHNESS_NOTE | "fresh" | "unknown";
}

const {
  id,
  seq,
  stem,
  options,
  answer,
  kind,
  year,
  point,
  analysis,
  aiAnalysis,
  freshness = "fresh",
} = Astro.props;

const multi = kind !== "single";
const note = FRESHNESS_NOTE[freshness as keyof typeof FRESHNESS_NOTE];
const payload = JSON.stringify({ id, answer, multi });
---

<section class="quiz" data-quiz={payload}>
  <header class="quiz-head">
    <div class="tags">
      {seq !== undefined && <span class="meta seq">{String(seq).padStart(2, "0")}</span>}
      <span class="meta kind" data-multi={String(multi)}>{KIND_LABEL[kind]}</span>
      {year && <span class="meta">{year}</span>}
      {point && <span class="meta">{point}</span>}
    </div>
    <button type="button" class="quiz-reset meta" hidden>重做</button>
  </header>

  {note && <p class="stale-note">{note}</p>}

  <p class="quiz-stem">{stem}</p>

  <ul class="quiz-options" aria-label="选项">
    {
      options.map((o) => (
        <li>
          <button type="button" class="quiz-opt" data-key={o.key} aria-pressed="false">
            <span class="box">{o.key}</span>
            <span class="text">{o.text}</span>
          </button>
        </li>
      ))
    }
  </ul>

  <div class="quiz-actions">
    <button type="button" class="quiz-submit" disabled>
      {multi ? "提交答案（可多选）" : "提交答案"}
    </button>
    <p class="quiz-result" aria-live="polite"></p>
  </div>

  <div class="quiz-analysis" hidden>
    <div class="an-block">
      <p class="meta an-label">解析</p>
      {
        analysis ? (
          <div class="an-text">{analysis}</div>
        ) : (
          <p class="an-text dim">题库未收录文字解析，对照正确选项复盘。</p>
        )
      }
    </div>

    {
      aiAnalysis && (
        <div class="ai-wrap">
          <p class="meta an-label ai-label">AI 解析</p>
          <p class="meta ai-hint">考点 · 法条 · 逐项 · 辨析 · 串联</p>
          <div class="ai-body">
            <div class="an-text">{aiAnalysis}</div>
          </div>
        </div>
      )
    }
  </div>
</section>

<script>
  import { bumpDay, todayKey } from "../../lib/activity";

  const KEY = "quiz-done";

  type Done = Record<string, string[]>;

  function readDone(): Done {
    try {
      return JSON.parse(localStorage.getItem(KEY) ?? "{}");
    } catch {
      return {};
    }
  }

  function saveDone(id: string, picked: string[] | null) {
    const all = readDone();
    if (picked) all[id] = picked;
    else delete all[id];
    localStorage.setItem(KEY, JSON.stringify(all));
  }

  document.querySelectorAll<HTMLElement>("[data-quiz]").forEach((root) => {
    const { id, answer, multi } = JSON.parse(root.dataset.quiz!) as {
      id: string;
      answer: string[];
      multi: boolean;
    };
    const opts = [...root.querySelectorAll<HTMLButtonElement>(".quiz-opt")];
    const submit = root.querySelector<HTMLButtonElement>(".quiz-submit")!;
    const result = root.querySelector<HTMLElement>(".quiz-result")!;
    const box = root.querySelector<HTMLElement>(".quiz-analysis")!;
    const resetBtn = root.querySelector<HTMLButtonElement>(".quiz-reset")!;
    let picked: string[] = [];

    const paint = (revealed: boolean) => {
      opts.forEach((btn) => {
        const k = btn.dataset.key!;
        const chosen = picked.includes(k);
        btn.classList.toggle("selected", chosen && !revealed);
        btn.setAttribute("aria-pressed", String(chosen));
        btn.disabled = revealed;
        btn.classList.toggle("correct", revealed && answer.includes(k));
        btn.classList.toggle("missed", revealed && answer.includes(k) && !chosen);
        btn.classList.toggle("wrong", revealed && chosen && !answer.includes(k));
      });
      submit.disabled = revealed || picked.length === 0;
      resetBtn.hidden = !revealed;
    };

    const reveal = (isRestore = false) => {
      // 法考多选漏选不得分，判定必须是完全相等而非包含
      const ok =
        picked.length === answer.length && answer.every((a) => picked.includes(a));
      const missed = answer.filter((a) => !picked.includes(a));
      result.textContent = ok
        ? "回答正确"
        : missed.length && picked.every((p) => answer.includes(p))
          ? `漏选，不得分 · 正确答案 ${answer.join("")}`
          : `回答错误 · 正确答案 ${answer.join("")}`;
      result.dataset.ok = String(ok);
      box.hidden = false;
      paint(true);
      saveDone(id, picked);
      if (!isRestore) {
        bumpDay(todayKey(), { addQuizzes: 1 });
        window.dispatchEvent(new Event("activity-change"));
      }
    };

    opts.forEach((btn) => {
      btn.addEventListener("click", () => {
        const k = btn.dataset.key!;
        if (multi) {
          picked = picked.includes(k) ? picked.filter((x) => x !== k) : [...picked, k].sort();
        } else {
          picked = [k];
        }
        paint(false);
      });
    });

    submit.addEventListener("click", reveal);

    resetBtn.addEventListener("click", () => {
      picked = [];
      result.textContent = "";
      delete result.dataset.ok;
      box.hidden = true;
      saveDone(id, null);
      paint(false);
    });

    const saved = readDone()[id];
    if (saved?.length) {
      picked = saved;
      reveal(true);
    } else {
      paint(false);
    }
  });
</script>

<style>
  .quiz {
    margin: 2.75rem 0;
    padding: 1.35rem 1.5rem 1.5rem;
    background: var(--paper);
    border: 1px solid var(--c-border);
    border-left: 3px solid var(--copper-soft);
    border-radius: 3px;
  }
  .quiz-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .seq {
    color: var(--copper);
  }
  .kind[data-multi="true"] {
    color: var(--accent);
  }
  .quiz-reset {
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
    font-family: var(--font-mono);
  }
  .quiz-reset:hover {
    color: var(--accent);
  }
  .stale-note {
    margin: 0 0 0.9rem;
    padding: 0.4rem 0.7rem;
    background: var(--copper-pale);
    color: var(--copper);
    border-radius: 3px;
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .quiz-stem {
    margin: 0 0 1.15rem;
    line-height: 1.9;
  }
  .quiz-options {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .quiz-opt {
    width: 100%;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    text-align: left;
    background: var(--paper-2);
    border: 1px solid var(--c-border);
    border-radius: 3px;
    color: var(--c-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.96rem;
    line-height: 1.75;
    padding: 0.6rem 0.8rem;
    transition: border-color 0.12s, background-color 0.12s;
  }
  .quiz-opt:hover:not(:disabled) {
    border-color: var(--accent-soft);
  }
  .box {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.45rem;
    flex: 0 0 1.45rem;
    height: 1.45rem;
    text-align: center;
    border: 1px solid var(--c-border-light);
    border-radius: 2px;
    color: var(--c-text-dim);
  }
  .quiz-opt.selected {
    border-color: var(--accent);
    background: var(--accent-pale);
  }
  .quiz-opt.selected .box {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--paper-2);
  }
  .quiz-opt.correct {
    border-color: var(--good);
    background: var(--good-pale);
  }
  .quiz-opt.correct .box {
    border-color: var(--good);
    color: var(--good);
  }
  /* 漏选：答案里有但没选中，用虚线框区别于选错 */
  .quiz-opt.missed .box {
    border-style: dashed;
  }
  .quiz-opt.wrong {
    border-color: var(--danger);
    background: var(--danger-pale);
  }
  .quiz-opt.wrong .box {
    border-color: var(--danger);
    color: var(--danger);
  }
  .quiz-opt:disabled {
    cursor: default;
  }
  .quiz-actions {
    margin-top: 1.1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .quiz-submit {
    background: none;
    border: 1px solid var(--c-border-light);
    border-radius: 3px;
    color: var(--c-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.88rem;
    padding: 0.4rem 1rem;
    transition: border-color 0.12s, color 0.12s;
  }
  .quiz-submit:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .quiz-submit:not(:disabled):hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .quiz-result {
    margin: 0;
    font-size: 0.88rem;
  }
  .quiz-result[data-ok="true"] {
    color: var(--good);
  }
  .quiz-result[data-ok="false"] {
    color: var(--danger);
  }
  .quiz-analysis {
    margin-top: 1.35rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--c-border);
  }
  .an-label {
    margin: 0 0 0.5rem;
    color: var(--copper);
  }
  .an-text {
    color: var(--c-text-muted);
    white-space: pre-line;
    line-height: 1.9;
    font-size: 0.93rem;
  }
  .an-text.dim {
    color: var(--c-text-dim);
  }
  .ai-wrap {
    margin-top: 1.1rem;
    border-top: 1px dashed var(--c-border);
    padding-top: 0.9rem;
  }
  .ai-label {
    margin: 0 0 0.25rem;
    color: var(--copper);
  }
  .ai-hint {
    margin: 0 0 0.65rem;
    color: var(--c-text-dim);
    font-size: 0.68rem;
  }
  .ai-body {
    padding: 0.9rem 1rem;
    background: var(--paper-2);
    border: 1px solid var(--c-border);
    border-radius: 3px;
  }
</style>
