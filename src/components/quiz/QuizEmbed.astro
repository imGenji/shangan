---
import QuizCard from "./QuizCard.astro";
import type { QuizQuestion } from "../../lib/quizzes";
import { getQuizAnalysis } from "../../data/quizzes/analyses";

interface Props {
  question: QuizQuestion;
  /** 文章内题号 */
  seq?: number;
}

const { question, seq } = Astro.props;
const ai = getQuizAnalysis(question.id);
---

<QuizCard
  id={question.id}
  seq={seq}
  stem={question.stem}
  options={question.options}
  answer={question.answer}
  kind={question.kind}
  year={question.year}
  point={question.point}
  analysis={question.analysis}
  aiAnalysis={ai?.text}
  freshness={question.freshness}
/>
