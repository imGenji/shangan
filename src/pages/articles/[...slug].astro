---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ImmersiveLayout from "../../layouts/ImmersiveLayout.astro";
import PostShell from "../../components/immersive/PostShell.astro";
import CheckIn from "../../components/immersive/CheckIn.astro";
import type { TocItem } from "../../lib/toc";
import { articleLabel } from "../../data/plan";
import { withBase } from "../../lib/base";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { title, summary, day, topic, tags, date, template, readMinutes, chapters } = article.data;
const { Content, headings } = await render(article);

const chapterToc: TocItem[] =
  chapters?.map((c) => ({ id: c.id, text: c.title, depth: 2 })) ?? [];
const headingToc: TocItem[] = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({ id: h.slug, text: h.text, depth: h.depth }));
const toc = chapterToc.length ? chapterToc : headingToc;

const isImmersive = template === "immersive";
const pageTitle = `${articleLabel(day)} · ${title}`;

const allArticles = (await getCollection("articles")).sort((a, b) => a.data.day - b.data.day);
const idx = allArticles.findIndex((a) => a.id === article.id);
const prevArticle = idx > 0 ? allArticles[idx - 1] : null;
const nextArticle = idx >= 0 && idx < allArticles.length - 1 ? allArticles[idx + 1] : null;

const toNav = (a: (typeof allArticles)[number]) => ({
  href: withBase(`articles/${a.id}/`),
  label: articleLabel(a.data.day),
  title: a.data.title,
});
---

{
  isImmersive ? (
    <ImmersiveLayout
      title={pageTitle}
      description={summary}
      day={day}
      date={date}
      topic={topic}
      tags={tags}
      readMinutes={readMinutes}
      toc={toc}
      prev={prevArticle ? toNav(prevArticle) : null}
      next={nextArticle ? toNav(nextArticle) : null}
    >
      <Content />
    </ImmersiveLayout>
  ) : (
    <BaseLayout title={pageTitle} description={summary}>
      <PostShell date={date} day={day} topic={topic} tags={tags} readMinutes={readMinutes} toc={toc}>
        <article>
          <header>
            <h1>{title}</h1>
            <p class="lede">{summary}</p>
          </header>
          <div class="prose">
            <Content />
          </div>
          <CheckIn day={day} />
        </article>
      </PostShell>
    </BaseLayout>
  )
}

<style>
  article {
    max-width: var(--w-text);
  }
  h1 {
    font-size: 2rem;
    margin: 0.6rem 0 1rem;
  }
  .lede {
    color: var(--c-text-muted);
    margin: 0 0 3rem;
  }
  .prose :global(h2) {
    font-size: 1.3rem;
    margin: 3rem 0 1rem;
    scroll-margin-top: 4rem;
  }
  .prose :global(h3) {
    font-size: 1.05rem;
    margin: 2rem 0 0.75rem;
    scroll-margin-top: 4rem;
  }
  .prose :global(li) {
    margin: 0.4rem 0;
  }
</style>
