---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ImmersiveLayout from "../../layouts/ImmersiveLayout.astro";
import PostShell from "../../components/immersive/PostShell.astro";
import type { TocItem } from "../../lib/toc";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { title, summary, day, topic, date, template, readMinutes, chapters } = article.data;
const { Content, headings } = await render(article);

const chapterToc: TocItem[] =
  chapters?.map((c) => ({ id: c.id, text: c.title, depth: 2 })) ?? [];
const headingToc: TocItem[] = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({ id: h.slug, text: h.text, depth: h.depth }));
const toc = chapterToc.length ? chapterToc : headingToc;

const isImmersive = template === "immersive";
---

{
  isImmersive ? (
    <ImmersiveLayout
      title={`Day ${day} · ${title}`}
      description={summary}
      day={day}
      date={date}
      topic={topic}
      readMinutes={readMinutes}
      toc={toc}
    >
      <Content />
    </ImmersiveLayout>
  ) : (
    <BaseLayout title={`Day ${day} · ${title}`} description={summary}>
      <PostShell date={date} day={day} topic={topic} readMinutes={readMinutes} toc={toc}>
        <article>
          <header>
            <h1>{title}</h1>
            <p class="lede">{summary}</p>
          </header>
          <div class="prose">
            <Content />
          </div>
          <footer class="checkin">
            <button id="checkin" type="button" data-day={day}>
              标记今天已完成
            </button>
          </footer>
        </article>
      </PostShell>
    </BaseLayout>
  )
}

<script>
  const btn = document.getElementById("checkin") as HTMLButtonElement | null;
  if (btn) {
    const day = Number(btn.dataset.day);
    const KEY = "checkins";
    const read = (): number[] => JSON.parse(localStorage.getItem(KEY) ?? "[]");
    const paint = () => {
      const done = read().includes(day);
      btn.textContent = done ? "已完成 · 点击撤销" : "标记今天已完成";
      btn.dataset.done = String(done);
    };
    btn.addEventListener("click", () => {
      const days = read();
      const next = days.includes(day) ? days.filter((d) => d !== day) : [...days, day];
      localStorage.setItem(KEY, JSON.stringify(next.sort((a, b) => a - b)));
      paint();
    });
    paint();
  }
</script>

<style>
  article {
    max-width: var(--w-text);
  }
  h1 {
    font-size: 2rem;
    margin: 0.6rem 0 1rem;
  }
  .lede {
    color: var(--c-text-muted);
    margin: 0 0 3rem;
  }
  .prose :global(h2) {
    font-size: 1.3rem;
    margin: 3rem 0 1rem;
    scroll-margin-top: 4rem;
  }
  .prose :global(h3) {
    font-size: 1.05rem;
    margin: 2rem 0 0.75rem;
    scroll-margin-top: 4rem;
  }
  .prose :global(li) {
    margin: 0.4rem 0;
  }
  .checkin {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--c-border);
  }
  #checkin {
    background: none;
    border: 1px solid var(--c-border-light);
    border-radius: 6px;
    color: var(--c-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.9rem;
    padding: 0.55rem 1.1rem;
  }
  #checkin:hover,
  #checkin[data-done="true"] {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
