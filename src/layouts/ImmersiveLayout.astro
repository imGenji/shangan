---
import BaseLayout from "./BaseLayout.astro";
import "../styles/article-mark.css";
import ReadingProgress from "../components/immersive/ReadingProgress.astro";
import ArticleNav from "../components/immersive/ArticleNav.astro";
import PostShell from "../components/immersive/PostShell.astro";
import CheckIn from "../components/immersive/CheckIn.astro";
import type { TocItem } from "../lib/toc";

interface NavItem {
  href: string;
  label: string;
  title: string;
}

interface Props {
  title: string;
  description?: string;
  day?: number;
  date: Date;
  topic?: string;
  tags?: string[];
  readMinutes?: number;
  toc?: TocItem[];
  prev?: NavItem | null;
  next?: NavItem | null;
}

const { title, description, day, date, topic, tags = [], readMinutes, toc = [], prev = null, next = null } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <ReadingProgress />
  <ArticleNav prev={prev} next={next} />
  <PostShell date={date} day={day ?? 0} topic={topic} tags={tags} readMinutes={readMinutes} toc={toc}>
    <article class="immersive">
      <slot />
      {day !== undefined && <CheckIn day={day} />}
    </article>
  </PostShell>
</BaseLayout>

<style>
  .immersive {
    max-width: none;
  }
</style>
