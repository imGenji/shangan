---
import BaseLayout from "./BaseLayout.astro";
import ReadingProgress from "../components/immersive/ReadingProgress.astro";

interface Props {
  title: string;
  description?: string;
  day?: number;
}

const { title, description, day } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <ReadingProgress />
  <article class="immersive">
    <slot />
    {
      day !== undefined && (
        <footer class="checkin">
          <button id="checkin" type="button" data-day={day}>
            标记今天已完成
          </button>
        </footer>
      )
    }
  </article>
</BaseLayout>

<script>
  const btn = document.getElementById("checkin") as HTMLButtonElement | null;
  if (btn) {
    const day = Number(btn.dataset.day);
    const KEY = "checkins";
    const read = (): number[] => JSON.parse(localStorage.getItem(KEY) ?? "[]");
    const paint = () => {
      const done = read().includes(day);
      btn.textContent = done ? "已完成 · 点击撤销" : "标记今天已完成";
      btn.dataset.done = String(done);
    };
    btn.addEventListener("click", () => {
      const days = read();
      const next = days.includes(day) ? days.filter((d) => d !== day) : [...days, day];
      localStorage.setItem(KEY, JSON.stringify(next.sort((a, b) => a - b)));
      paint();
    });
    paint();
  }
</script>

<style>
  .immersive {
    max-width: var(--w-text);
  }
  .checkin {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--c-border);
  }
  #checkin {
    background: none;
    border: 1px solid var(--c-border-light);
    border-radius: 6px;
    color: var(--c-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.9rem;
    padding: 0.55rem 1.1rem;
  }
  #checkin:hover,
  #checkin[data-done="true"] {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
